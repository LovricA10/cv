---
interface Props {
    /** "tech" renders the technical skill groups, "other" renders the "other skills" block. */
    part?: "tech" | "other";
}

const { part = "tech" } = Astro.props;

const skupineVjestina = [
    {
        naziv: "Programski jezici",
        ikona: "/icons/code.svg",
        vjestine: ["C++", "C#", "Java", "JavaScript", "TypeScript", "Python"],
    },
    {
        naziv: "Web tehnologije",
        ikona: "/icons/web.svg",
        vjestine: ["HTML", "CSS", "React"],
    },
    {
        naziv: "Backend",
        ikona: "/icons/backend.svg",
        vjestine: ["Spring Boot", "REST API", "FastAPI", "SQLAlchemy", "Alembic"],
    },
    {
        naziv: "Baze podataka",
        ikona: "/icons/database.svg",
        vjestine: ["PostgreSQL", "SQL", "SQLite"],
    },
    {
        naziv: "DevOps i alati",
        ikona: "/icons/devops.svg",
        vjestine: ["Docker", "Git", "GitHub", "Jira", "CI/CD", "Docker Compose", "GitHub Actions"],
    },
    {
        naziv: "Podaci i testiranje",
        ikona: "/icons/data.svg",
        vjestine: ["pandas", "pytest"],
    },
    {
        naziv: "Ostale vještine",
        ikona: null,
        vjestine: [
            "Microsoft Office (Word, Excel, PowerPoint)",
            "Rješavanje programskih problema",
            "Osnove kibernetičke sigurnosti (certifikat)",
            "Komunikacijske vještine",
            "Vozačka dozvola B kategorije",
        ],
    },
];

// Keep original indices so the i18n keys (skills.groups.N) stay correct.
const indeksirane = skupineVjestina.map((grupa, gi) => ({ ...grupa, gi }));
const tehnicke = indeksirane.filter((g) => g.ikona);
const ostale = indeksirane.filter((g) => !g.ikona);
---

{part === "tech" ? (
    <section class="section section-box">
        <h2 class="section-title">
            <img src="/icons/skills.svg" alt="" />
            <span data-i18n="skills.title">Vještine</span>
        </h2>

        <div class="skill-groups">
            {tehnicke.map((grupa) => (
                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <img src={grupa.ikona} alt="" />
                        <span data-i18n={`skills.groups.${grupa.gi}.name`}>{grupa.naziv}</span>
                    </h3>
                    <div class="badge-list">
                        {grupa.vjestine.map((v) => <span class="badge">{v}</span>)}
                    </div>
                </div>
            ))}
        </div>
    </section>
) : (
    ostale.map((grupa) => (
        <section class="section">
            <h2 class="section-title">
                <img src="/icons/info.svg" alt="" />
                <span data-i18n={`skills.groups.${grupa.gi}.name`}>{grupa.naziv}</span>
            </h2>
            <ul class="check-list">
                {grupa.vjestine.map((v, vi) => (
                    <li data-i18n={`skills.other.${vi}`}>{v}</li>
                ))}
            </ul>
        </section>
    ))
)}

<style>
    .skill-groups {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .skill-group {
        break-inside: avoid;
    }

    .skill-group-title {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 0.55rem;
    }

    .skill-group-title img {
        width: 16px;
        height: 16px;
    }

    .badge-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }
</style>
