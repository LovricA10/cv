---
---

<header class="cv-header">
    <div class="header-left">
        <h1>Andrej Lovrić</h1>
        <p class="tagline" data-i18n="header.tagline">Software Engineer</p>
        <p class="location">
            <img src="/icons/location.svg" alt="lokacija" />
            <span data-i18n="header.location">Croatia</span>
        </p>
    </div>

    <div class="header-right">
        <div class="lang-switcher no-print">
            <button class="lang-btn active" data-lang="hr">HR</button>
            <button class="lang-btn" data-lang="en">EN</button>
        </div>
        <ul class="contact-list">
            <li>
                <a href="https://github.com/LovricA10" target="_blank">
                    <img src="/icons/github.svg" alt="github" />
                    github.com/LovricA10
                </a>
            </li>
        </ul>
    </div>
</header>

<script>
    import { initI18n, setLang, getCurrentLang } from '../i18n/utils';

    // Initialize on page load
    initI18n();

    // Set correct active button based on stored lang
    document.querySelectorAll<HTMLElement>('.lang-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === getCurrentLang());
    });

    // Wire up buttons
    document.querySelectorAll<HTMLElement>('.lang-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const lang = btn.getAttribute('data-lang') as 'hr' | 'en';
            setLang(lang);
        });
    });
</script>

<style>
    .cv-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
    }

    .header-left {
        position: relative;
        padding-left: 1.5rem;
    }

    .header-left::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.5rem;
        height: 5.4rem;
        width: 6px;
        border-radius: 6px;
        background: var(--color-primary);
    }

    .header-left h1 {
        font-size: 3.1rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.1;
        color: var(--color-text);
    }

    .tagline {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--color-primary);
        line-height: 1.25;
        margin-top: 0.2rem;
    }

    .location {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 0.85rem;
        font-size: 1.05rem;
        color: var(--color-text-muted);
    }

    .location img {
        width: 18px;
        height: 18px;
    }

    .header-right {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.9rem;
        padding-top: 0.5rem;
    }

    .contact-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .contact-list a {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--color-text);
        font-size: 1rem;
    }

    .contact-list img {
        width: 20px;
        height: 20px;
    }

    .lang-switcher {
        display: flex;
        gap: 0.3rem;
    }

    .lang-btn {
        padding: 0.25rem 0.7rem;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        border: 1.5px solid var(--color-line);
        border-radius: 999px;
        background: white;
        color: var(--color-primary);
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .lang-btn:hover {
        border-color: var(--color-primary);
        background: var(--color-primary-tint);
    }

    .lang-btn.active {
        background: var(--color-primary);
        color: white;
        border-color: var(--color-primary);
    }

    @media screen and (max-width: 820px) {
        .cv-header {
            flex-direction: column;
            gap: 1.5rem;
        }

        .header-left h1 {
            font-size: 2.4rem;
        }

        .header-left::before {
            height: 4.4rem;
        }

        .tagline {
            font-size: 1.4rem;
        }

        .header-right {
            padding-top: 0;
            padding-left: 1.5rem;
        }

        .lang-switcher {
            order: -1;
        }
    }
</style>
