---
const obrazovanje = [
    {
        naziv: "Programsko inženjerstvo",
        ustanova: "Sveučilište Algebra Bernays",
        lokacija: "Zagreb, Hrvatska",
        period: "2023 - danas",
    },
    {
        naziv: "Tehničar za računalstvo",
        ustanova: "Elektrotehnička škola Split",
        lokacija: "Split, Hrvatska",
        period: "2019 - 2023",
    },
    {
        naziv: "EDIT Code School",
        ustanova: "EDIT Code School",
        lokacija: "Split, Hrvatska",
        period: "2020",
    },
];
---

<section class="section section-box">
    <h2 class="section-title">
        <img src="/icons/education.svg" alt="" />
        <span data-i18n="education.title">Obrazovanje</span>
    </h2>

    <div class="timeline timeline--compact">
        {obrazovanje.map((item, i) => (
            <div class="timeline-item">
                <div class="item-header">
                    <div>
                        <h3 class="item-title edu-title" data-i18n={`education.items.${i}.degree`}>{item.naziv}</h3>
                        <span class="item-subtitle edu-sub" data-i18n={`education.items.${i}.institution`}>{item.ustanova}</span>
                        <p class="item-meta" data-i18n={`education.items.${i}.location`}>{item.lokacija}</p>
                    </div>
                    <span class="period" data-i18n={`education.items.${i}.period`}>{item.period}</span>
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .edu-title {
        font-size: 1rem;
    }

    .edu-sub {
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>
