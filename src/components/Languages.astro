---
const jezici = [
    { naziv: "Hrvatski", razina: "Maternji" },
    { naziv: "Engleski", razina: "Tečno" },
];
---

<section class="section">
    <h2 class="section-title">
        <img src="/icons/languages.svg" alt="" />
        <span data-i18n="languages.title">Jezici</span>
    </h2>

    <ul class="lang-list">
        {jezici.map((j, i) => (
            <li class="lang-row">
                <span class="lang-naziv" data-i18n={`languages.items.${i}.name`}>{j.naziv}</span>
                <span class="lang-razina" data-i18n={`languages.items.${i}.level`}>{j.razina}</span>
            </li>
        ))}
    </ul>
</section>

<style>
    .lang-list {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .lang-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.55rem 0.9rem;
        border-radius: 10px;
        background: var(--color-primary-tint);
    }

    .lang-naziv {
        font-size: 0.98rem;
        font-weight: 700;
    }

    .lang-razina {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-primary);
    }
</style>
